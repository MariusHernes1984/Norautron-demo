{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "principalName": {
      "value": "${AZURE_PRINCIPAL_NAME=deployment-user}"
    },
    "principalType": {
      "value": "${AZURE_SQL_ADMIN_PRINCIPAL_TYPE=User}"
    },
    "foundryResourceGroupName": {
      "value": "${AZURE_FOUNDRY_RESOURCE_GROUP=RG-KATE}"
    },
    "foundryAccountName": {
      "value": "${AZURE_FOUNDRY_ACCOUNT_NAME=kateecosystem-resource}"
    },
    "foundryDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra}"
    },
    "foundryEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT=https://kateecosystem-resource.openai.azure.com}"
    }
  }
}
